rules_version = '2';

// LogiTrack rules.
//
// Dispatchers (signed in): full read/write on both collections — used by
// the internal dashboard at "/", which lists the whole shipments
// collection and edits any document.
//
// Public (no auth): the "/track" page looks up exactly one shipment by an
// exact trackingId match (see lib/firestore-helpers.ts,
// lookupShipmentByTrackingId), capped at limit(1) on the client.
//
// Firestore rules are NOT filters — a query is only permitted if every
// document it could possibly return satisfies the rule, evaluated against
// the query's own structure (its where/limit clauses), not against
// individual field values after the fact. Capping the public path to
// request.query.limit <= 1 keeps it from ever being usable to dump the
// collection, while still letting a single exact-id lookup through. This
// mirrors how a real carrier's tracking page works: knowing the tracking
// id (a long random value, see generateTrackingId) is the access control,
// the same as typing one into ups.com or fedex.com.
service cloud.firestore {
  match /databases/{database}/documents {
    match /shipments/{shipmentId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null || request.query.limit <= 1;
      allow write: if request.auth != null;
    }
    match /activityLog/{entryId} {
      allow read, write: if request.auth != null;
    }
  }
}
